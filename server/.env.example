# Copy to server/.env and fill in. Never commit server/.env.
# Local and staging only: never put production credentials here (CLAUDE.md hard rule 9).

# JWT signing secret: any long random string; use a different one per environment
MY_SECRET=

# MongoDB connection string. Locally this must name bubblydatabase3_staging (or a local database);
# maintenance scripts refuse anything else. Falls back to mongodb://127.0.0.1:27017/bubblywater if empty.
MONGODB_URI=

# Gmail account + app password used to send verification and password-reset emails
SENDER_EMAIL_ADDRESS=
SENDER_EMAIL_PASSWORD=

# Base URL used in email links, e.g. http://localhost:5001 locally
WEBSITE_URL=

# Comma-separated user _ids allowed to use admin-only operations (users query, removeUser).
# Empty = nobody is an admin.
ADMIN_USER_IDS=

# Set by Render in production; not needed locally
# NODE_ENV=production
# PORT=3000
